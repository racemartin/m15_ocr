# Copier ce fichier en .env et renseigner les valeurs réelles.
# .env est gitignored : jamais de secret réel dans ce fichier-ci (.env.example).

# --- Hugging Face Hub -------------------------------------------------------
# Jeton avec le rôle "write" si on écrit dans un dataset (journal d'audit en
# mode hf_dataset), "read" suffit pour seulement vérifier l'accès.
HF_TOKEN=

# Dataset HF du journal d'audit (optionnel, repris de m14_ocr), ex. :
# mombasstic/chsa-triage-audit-journal
CHSA_JOURNAL_AUDIT_REPO=

# --- Système audité (m14_ocr) -----------------------------------------------
# URL DE BASE de l'API chsa-triage à auditer. Local ou distant (Space HF) :
# c'est la même variable, seule la valeur change, jamais un "mode" séparé.
# Exemple local  : http://127.0.0.1:7860
# Exemple distant : https://mombasstic-chsa-triage-api.hf.space
CHSA_TRIAGE_URL_BASE=

# Clé API (X-API-Key) exigée par les routes protégées de chsa-triage
# (toutes sauf /sante). Optionnelle tant qu'on ne vérifie que /sante.
CHSA_TRIAGE_CLE_API=

# Configuration de déploiement actuellement auditée (étiquette Prometheus
# "configuration" sur chaque métrique). m15 audite par HTTP, depuis
# l'extérieur : il ne peut PAS déduire cette valeur tout seul (surtout pas
# sur un Space HF distant) — c'est à toi de la déclarer, comme on étiquette
# une cible Prometheus. Valeurs reprises de
# m14_ocr/docs/diagrams/05_etape4_deploiement/deployement_options_V2.png :
#   config1_remote_vllm_space_separe   (bf16, GPU, Streamlit local + Space)
#   config2_remote_vllm_space_unique   (bf16, GPU, tout dans le Space)
#   staging1_local_gguf                (Q4_K_M, CPU, llama.cpp — gratuit)
#   staging2_local_transformers_peft   (bf16, CPU, comparaison hors ligne)
CHSA_TRIAGE_CONFIGURATION=

# --- MLflow (optionnel, réutilisé du m14_ocr) -------------------------------
MLFLOW_TRACKING_URI=

# --- Journal d'audit de m14_ocr (uv run instrumenter-journal) ---------------
# Chemin LOCAL vers le .jsonl écrit par chsa-triage (CHSA_CHEMIN_JOURNAL_AUDIT
# côté m14_ocr). Frontière locale explicite (voir docs/00_architecture.md
# "Accès au journal d'audit") : contrairement à CHSA_TRIAGE_URL_BASE, cette
# variable suppose que m15 et m14_ocr tournent sur la même machine. Un
# chemin différent par configuration auditée, ex. :
#   /mnt/c/Users/Public/IAE_DELL/pra_dell/m14_ocr/data/processed/journal_audit__staging1_local_gguf.jsonl
CHSA_TRIAGE_CHEMIN_JOURNAL_AUDIT=

# --- Serveur de métriques en continu (uv run servir-metriques) --------------
# Port HTTP du endpoint /metrics que Prometheus scrape en continu.
CHSA_PORT_METRIQUES=9200

# Fréquence à laquelle CE processus relit lui-même ses sources (pas la
# fréquence de scrape de Prometheus, qui lit toujours la dernière valeur
# connue entre deux sondages).
CHSA_INTERVALLE_SONDAGE_SECONDES=30

# --- Pile d'observabilité (docker-compose.yml) -------------------------------
# Lu directement par docker compose (même fichier .env, à la racine du
# dépôt) : mot de passe du compte admin Grafana. "admin" si absent.
GRAFANA_ADMIN_PASSWORD=
