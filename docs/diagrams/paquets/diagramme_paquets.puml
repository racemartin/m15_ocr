@startuml diagramme_paquets
skinparam backgroundColor white
skinparam defaultFontName Helvetica
skinparam defaultFontSize 13
skinparam shadowing false
skinparam packageStyle rectangle
skinparam ArrowColor #555555

title m15_ocr — Diagramme de paquets

package "domain" as DOMAIN #CFE8FF {
  package "model" as DOMAIN_MODEL
  package "ports" as DOMAIN_PORTS
}

package "application" as APPLICATION #D8F5D0 {
  package "services" as APPLICATION_SERVICES
}

package "infrastructure" as INFRA #FFE3C4 {
  package "adapters" as INFRA_ADAPTERS
}

package "interfaces" as INTERFACES #F5D0E8 {
  package "cli" as INTERFACES_CLI
}

INTERFACES_CLI --> APPLICATION_SERVICES : construit et exécute
INTERFACES_CLI --> INFRA_ADAPTERS : injecte les adaptateurs concrets
APPLICATION_SERVICES --> DOMAIN_PORTS : dépend des contrats
APPLICATION_SERVICES --> DOMAIN_MODEL : utilise les structures
INFRA_ADAPTERS ..|> DOMAIN_PORTS : implémente
INFRA_ADAPTERS --> DOMAIN_MODEL : produit/consomme

note right of DOMAIN
  Le domaine ne dépend d'AUCUN
  autre paquet (sauf la bibliothèque
  standard) : c'est le centre de
  l'hexagone, jamais l'inverse.
end note

@enduml
